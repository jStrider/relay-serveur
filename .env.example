# Identifiants API OVH (Terraform et Makefile). Les commentaires restent sur leur propre ligne :
# avec `include .env`, make garderait les espaces avant un # de fin de ligne dans la valeur.
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=…
OVH_APPLICATION_SECRET=…
OVH_CONSUMER_KEY=…
# Projet Public Cloud du bucket de sauvegarde
OVH_CLOUD_PROJECT_ID=…
# Le domaine de Relay, géré chez OVH (le relais répond sur relay.<zone>)
RELAY_ZONE=…

# Mot de passe du dépôt restic, à garder aussi dans le gestionnaire de mots de passe
RESTIC_PASSWORD=…

# 1 : aucune barrière d'abonnement (auto-hébergement)
RELAY_GRATUIT=0
# Clé APNs (App Store Connect → Users and Access → Keys), son identifiant, l'équipe Apple
APNS_CLE_FICHIER=~/…/AuthKey_XXXXXXXXXX.p8
APNS_CLE_ID=XXXXXXXXXX
APNS_EQUIPE=…
# Bundle id de l'app, aussi utilisé pour vérifier les transactions ; identifiant numérique de l'app
# (0 tant qu'il n'existe pas : seules les transactions sandbox sont alors acceptées ; sinon production puis sandbox)
APNS_BUNDLE=…
APPLE_APP_ID=0
