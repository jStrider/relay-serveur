# Identifiants API OVH (Terraform et Makefile)
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=…
OVH_APPLICATION_SECRET=…
OVH_CONSUMER_KEY=…
OVH_CLOUD_PROJECT_ID=…        # projet Public Cloud du bucket de sauvegarde
RELAY_ZONE=…                  # le domaine de Relay, géré chez OVH (relay.<zone>)

RESTIC_PASSWORD=…             # à garder aussi dans le gestionnaire de mots de passe

RELAY_GRATUIT=0               # 1 : aucune barrière d'abonnement (auto-hébergement)
APNS_CLE_FICHIER=~/…/AuthKey_XXXXXXXXXX.p8   # clé APNs (App Store Connect → Users and Access → Keys)
APNS_CLE_ID=XXXXXXXXXX
APNS_EQUIPE=…                 # identifiant d'équipe Apple
APNS_BUNDLE=…                 # bundle id de l'app, aussi utilisé pour vérifier les transactions
APPLE_APP_ID=0                # identifiant numérique de l'app dans App Store Connect
APPLE_ENV=Sandbox             # Production une fois l'app dans l'App Store
